{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "spoonfull",
  "version": "0.1.0",
  "identifier": "com.spoonfull.dev",
  "build": {
    "frontendDist": "../dist/food-intake/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "spoonfull",
        "width": 1024,
        "height": 600,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}